<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 解析接口和下载都是网络请求。调试清单里那份只对 debug 构建生效,
         release 包必须在主清单声明,否则装上去所有网络调用直接失败。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新:下完 APK 要拉起系统安装器。Android 8 起还得用户在系统设置里
         单独给「安装未知应用」授权,这里只声明"我要装应用"。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 下载保活:退到后台继续下,不被系统随手清掉(实现见 DownloadKeepAlive.kt)。
         后两条是 Android 14 起的要求 —— 前台服务必须声明类型,不声明 startForeground 会抛;
         WAKE_LOCK 是同一件事的另一半:光把进程提到前台,CPU 照样可以睡。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 备份与换机迁移一律关掉:本机私有数据里有解析历史、主题偏好、接口域名与优选 IP
         的落盘(见 lib/history_store.dart、lib/api_host.dart)。默认 allowBackup=true
         时这些能被 adb backup 或云备份取走 —— 历史等于"用户下过什么"。
         代价:换机不带走设置,这是明知的取舍。 -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:largeHeap="true">
        <!-- largeHeap:预览那个播放器是 ExoPlayer(走 media3),它按「秒数」缓冲
             而不按字节数 —— 抖音这条 8K 原画是 34 Mbps,缓冲几十秒就是 200MB 上下,
             正好把默认的 256MB Java 堆吃光,报 java.lang.OutOfMemoryError 然后闪退
             (真机 tombstone 实测:target footprint 268435456,growth limit 同值)。
             开这个把堆上限抬到 512MB 甚至更高。它不解决"为什么缓冲这么多",只是
             把天花板抬起来;真要根治得让预览只拉低码率那一档。 -->
        <!-- 键盘用 adjustNothing,不是 adjustResize。
             resize 会让窗口随键盘收缩,系统就要在这个窗口上逐帧跑 IME 的
             insets 动画(真机 trace 里能看到 InsetsAnimation: ime /
             dispatchApplyInsets / windowResized 全压在主线程上),
             结果是 20 帧里有 11 帧超期被丢、帧间隔拉到 84~119ms ——
             换任何输入法都一样,因为动画是窗口系统在跑,不是输入法在跑。
             界面本来也不为键盘让位(根 GlassScaffold 是
             resizeToAvoidBottomInset: false,输入框在页面顶部),
             所以窗口收缩纯属白跑:改成 nothing 后键盘直接盖在内容上。
             启动页已移除:MainActivity 就是 launcher 入口(MAIN/LAUNCHER),
             窗口背景直接用纯色 NormalTheme(浅色白/深色黑),点开即进主界面。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/NormalTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustNothing">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 下载期间的前台服务(见 DownloadKeepAlive.kt):把进程钉在前台,免得退到后台
             被杀、下载断在半路。exported=false —— 只有本应用能起它。 -->
        <service
            android:name=".DownloadKeepingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 应用内更新的安装包住在应用私有缓存目录里。Android 7 起不能把 file://
             递给安装器(FileUriExposedException),必须由 FileProvider 换成
             content:// 并临时授权。paths 见 res/xml/file_paths.xml。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_icon_color" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
